# Template for backend/.env. Copy to backend/.env and fill in real values.
# Never commit backend/.env. In production these come from the hosting platform's secret store.

# development | test | staging | production
ENVIRONMENT=development

# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173"]

# Must match infra/.env. Use 127.0.0.1 rather than localhost on Windows.
DATABASE_URL=postgresql+asyncpg://quantova:change-me@127.0.0.1:5432/quantova
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# Used only by the test suite. The database name MUST end in "_test";
# the tests refuse to run otherwise, to protect development data.
TEST_DATABASE_URL=postgresql+asyncpg://quantova:change-me@127.0.0.1:5432/quantova_test
TEST_REDIS_URL=redis://:change-me@127.0.0.1:6379/1

# Signs access tokens. Minimum 32 characters; use 64 random hex characters:
#   [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Anyone with this key can impersonate any user. Changing it logs everyone out.
JWT_SECRET_KEY=change-me

# Optional token lifetimes (defaults shown).
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=14

# ── Added in later phases ─────────────────────────────
# OPENAI_API_KEY=          (Phase 5)
# STRIPE_SECRET_KEY=       (Phase 6)
# STRIPE_WEBHOOK_SECRET=   (Phase 6)

# AI insights (optional). Leave OPENAI_API_KEY empty to switch AI features off.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
