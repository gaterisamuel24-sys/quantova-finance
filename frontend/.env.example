# Template for frontend/.env.local. Copy only if you need to override a value.
#
# WARNING: every VITE_* variable is embedded into the JavaScript bundle and is
# visible to anyone who opens the site. Never put secrets here.

# Base URL of the API. Leave empty in development: requests go to /api and the
# Vite dev server proxies them to FastAPI. In production, set it if the API is
# served from a different domain (e.g. https://api.quantova.example).
VITE_API_BASE_URL=
